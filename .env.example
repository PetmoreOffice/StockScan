# Set DEMO_MODE=true to preview the UI without connecting to SQL Server.
DEMO_MODE=true

# Central inventory API. The Firebase API key is public client configuration; never put SQL credentials here.
INVENTORY_API_URL=http://127.0.0.1:3001/api/v1
NEXT_PUBLIC_FIREBASE_API_KEY=replace_with_the_shared_firebase_web_api_key

# SQL Server read-only connection used only for branches. The application only issues SELECT queries.
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=YourDatabase
SQL_USER=readonly_user
SQL_PASSWORD=replace_me
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# Keep the master workbook on the server's own disk, outside the public web directory.
EXCEL_FILE_PATH=./data/ScanData.xlsx

# Optional: publish a copy here after every save so other departments can open it.
# Use a UNC path, not a mapped drive letter, so it still resolves when the app runs
# as a Windows service. Leave empty to skip publishing.
EXCEL_MIRROR_PATH=
