# Set DEMO_MODE=true to preview the UI without connecting to SQL Server.
DEMO_MODE=true

# SQL Server read-only connection. The application only issues SELECT queries.
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=YourDatabase
SQL_USER=readonly_user
SQL_PASSWORD=replace_me
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# Keep the shared workbook outside the public web directory.
EXCEL_FILE_PATH=./data/ScanData.xlsx
